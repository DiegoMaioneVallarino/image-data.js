{
  "name": "image-data.js",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Motor de an\u00e1lisis e indexaci\u00f3n visual para navegador",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "tsup",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "prepack": "npm run build:lib"
  },
  "dependencies": {
    "onnxruntime-web": "^1.20.0",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "~5.8.3",
    "vite": "^6.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
